# Copy to deploy/.env on the host (never commit .env). Values here are placeholders.

# --- TLS (Caddy) ---
DOMAIN=nextrecordable.example.com
ACME_EMAIL=ops@example.com

# --- App ---
NEXTRECORDABLE_BASE_URL=https://nextrecordable.example.com
NEXTRECORDABLE_CONTACT_EMAIL=hello@example.com

# --- Email: dryrun writes .eml files to data/outbox; switch to smtp when the provider is verified ---
NEXTRECORDABLE_MAIL_PROVIDER=dryrun
NEXTRECORDABLE_MAIL_FROM=nextrecordable <keys@example.com>
# NEXTRECORDABLE_SMTP_HOST=smtp.postmarkapp.com
# NEXTRECORDABLE_SMTP_PORT=587
# NEXTRECORDABLE_SMTP_USER=
# NEXTRECORDABLE_SMTP_PASSWORD=

# --- Stripe (TEST mode until the launch checklist says otherwise) ---
NEXTRECORDABLE_STRIPE_WEBHOOK_SECRET=whsec_replace_me
# JSON map from Payment Link id to tier
NEXTRECORDABLE_STRIPE_LINK_TIERS={"plink_replace_pro": "pro", "plink_replace_team": "team"}
NEXTRECORDABLE_PAYMENT_LINK_PRO=https://buy.stripe.com/test_replace_me
NEXTRECORDABLE_PAYMENT_LINK_TEAM=https://buy.stripe.com/test_replace_me
